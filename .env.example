# Planora AI - Environment Configuration Example
# Copy this file to .env for local development

# Google Gemini API Key (Required for AI planning features)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Optional, defaults to gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash
